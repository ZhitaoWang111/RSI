diff --git a/pyproject.toml b/pyproject.toml
index 5e61e4c..047d96b 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -19,8 +19,14 @@ extend-exclude = "deprecated/"
 # https://pypi.org/project/setuptools-scm/
 # NOTE: If these values are updated, they need to be also updated in `__init__.py`.
 [tool.setuptools_scm]
-version_scheme = "no-guess-dev"
-local_scheme = "dirty-tag"
+# Local patch (ASPIRE checkout): pin the version so metadata generation does not
+# depend on git tags or working-tree state. Shallow submodule clones lose the
+# v0.7.8 tag and uv's isolated build env cannot see .git, so stock
+# `no-guess-dev` yielded 0.0.post1.dev1, which mismatches uv.lock.
+# setuptools_scm 10.x removed `plain`; `only-version` replaces it.
+version_scheme = "only-version"
+local_scheme = "no-local-version"
+fallback_version = "0.7.8"

 [tool.isort]
 # see https://github.com/PyCQA/isort#multi-line-output-modes
diff --git a/setup.py b/setup.py
index 393d489..3a1be5a 100644
--- a/setup.py
+++ b/setup.py
@@ -32,7 +32,13 @@ extra_cuda_args = {
         "--fmad=true",
         "--prec-div=false",
         "--prec-sqrt=false",
-    ]
+        # Local patch: build as C++17; helper_math.h defines a global `lerp`
+        # that clashes with std::lerp under C++20 (gcc 13).
+        "-std=c++17",
+    ],
+    "cxx": [
+        "-std=c++17",
+    ],
 }

